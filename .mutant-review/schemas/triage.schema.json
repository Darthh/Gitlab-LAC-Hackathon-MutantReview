{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "mutantFingerprints": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "actionable-testing-gap",
        "possibly-equivalent",
        "possibly-low-priority",
        "insufficient-contract-information",
        "execution-problem"
      ]
    },
    "behavioralGap": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "requirementReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "suggestedTests": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input": {
            "type": [
              "string",
              "number"
            ]
          },
          "expected": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "input",
          "expected",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "proposedPatch": {
      "type": "string",
      "maxLength": 30000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  },
  "required": [
    "findingId",
    "mutantFingerprints",
    "classification",
    "behavioralGap",
    "requirementReference",
    "suggestedTests",
    "proposedPatch",
    "confidence",
    "uncertainty"
  ],
  "additionalProperties": false
}
