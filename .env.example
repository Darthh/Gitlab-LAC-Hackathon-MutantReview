# Front Desk (read-only; no credentials). Cloud Run sets PORT and needs HOST=0.0.0.0.
PORT=4173
HOST=127.0.0.1
# The Duo flow's service-account mention, shown in the console and used by CI,
# e.g. @ai-mutant-review-evidence-triage-mutant-review
MUTANT_REVIEW_HANDLE=
# CI only (masked project CI/CD variable, Reporter role, api scope): post findings,
# verify override comments, open test-debt issues. Never give it to Front Desk.
MUTANT_REVIEW_TOKEN=
