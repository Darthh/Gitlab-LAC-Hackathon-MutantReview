PORT=4173
# Optional: configure one approved demonstration project. Tokens stay server-side.
GITLAB_URL=https://gitlab.com
GITLAB_PROJECT_ID=
GITLAB_READ_TOKEN=
GITLAB_MR_IID=
GITLAB_EVIDENCE_JOB_ID=
GITLAB_FLOW_HANDLE=
# Optional credential-free delivery of an authenticated, Ed25519-signed artifact capture.
# Configure both paths plus project/MR/job IDs. Front Desk reads only the public key.
GITLAB_EVIDENCE_CACHE_FILE=
GITLAB_EVIDENCE_PUBLIC_KEY_FILE=
# Trusted operator CLI only. Keep this OUT of the Front Desk runtime and MR CI jobs.
GITLAB_WRITE_TOKEN=
# Absolute durable directory outside the checkout for immutable approval receipts.
MUTANT_REVIEW_STATE_DIR=
