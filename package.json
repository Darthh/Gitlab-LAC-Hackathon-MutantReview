{
  "name": "mutant-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx apps/front-desk/server/index.ts",
    "build": "tsc --noEmit && vite build --config apps/front-desk/vite.config.ts",
    "start": "tsx apps/front-desk/server/index.ts --production",
    "test": "vitest run",
    "test:domain": "vitest run --config vitest.domain.config.ts",
    "demo": "tsx packages/cli/src/index.ts demo",
    "review": "tsx packages/cli/src/index.ts review",
    "gate": "tsx packages/cli/src/index.ts gate",
    "typecheck": "tsc --noEmit",
    "mr": "tsx packages/cli/src/index.ts",
    "check": "tsx packages/cli/src/index.ts check",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.1"
    }
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "4.1.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
