be '' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":3.4445999999989,"killedBy":["0"],"coveredBy":["0","1","2","3","4","5","6","8","9"],"location":{"end":{"column":28,"line":41},"start":{"column":10,"line":41}}},{"id":"19","mutatorName":"StringLiteral","replacement":"``","statusReason":"expected '' to be '?b=y&a=x' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":3.5920999999998457,"killedBy":["1"],"coveredBy":["1","2","3","4","5","6","8","9"],"location":{"end":{"column":57,"line":41},"start":{"column":36,"line":41}}},{"id":"20","mutatorName":"StringLiteral","replacement":"\"\"","statusReason":"expected '?b=ya=x' to be '?b=y&a=x' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":4.09900000000016,"killedBy":["1"],"coveredBy":["1","2","3","4","5","6","8","9"],"location":{"end":{"column":54,"line":41},"start":{"column":51,"line":41}}}],"source":"type QueryValue = string | number | boolean | bigint | null | undefined;\r\n\r\n/**\r\n * Converts a flat object into a URL search string, such as `?a=1&b=2`.\r\n *\r\n * - `null` and `undefined` values are omitted, including inside arrays.\r\n * - Arrays are serialized as repeated keys, such as `a=1&a=2`.\r\n * - Other values are converted with `String()`.\r\n * - Keys and values are encoded with `encodeURIComponent`, so spaces become `%20` and `+` becomes `%2B`.\r\n *\r\n * @template T - The type of the object to serialize.\r\n * @param query - The object to serialize.\r\n * @returns The search string starting with `?`, or an empty string when there is nothing to serialize.\r\n * @throws {URIError} Throws when a key or value contains an unpaired surrogate.\r\n *\r\n * @example\r\n * stringify({ page: 1, tags: ['a', 'b'], q: 'hello world', ref: undefined });\r\n * // => '?page=1&tags=a&tags=b&q=hello%20world'\r\n *\r\n * stringify({ ref: undefined });\r\n * // => ''\r\n */\r\nexport function stringify<T extends object & { [K in keyof T]: QueryValue | readonly QueryValue[] }>(query: T): string {\r\n  const parts: string[] = [];\r\n  const keys = Object.keys(query) as Array<keyof T & string>;\r\n\r\n  for (let i = 0; i < keys.length; i++) {\r\n    const key = keys[i];\r\n    const value = query[key];\r\n    const values: readonly QueryValue[] = Array.isArray(value) ? value : [value];\r\n\r\n    for (let j = 0; j < values.length; j++) {\r\n      const item = values[j];\r\n\r\n      if (item != null) {\r\n        parts.push(`${encodeURIComponent(key)}=${encodeURIComponent(String(item))}`);\r\n      }\r\n    }\r\n  }\r\n\r\n  return parts.length === 0 ? '' : `?${parts.join('&')}`;\r\n}\r\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"src/query-string/stringify.spec.ts":{"tests":[{"id":"0","name":"stringify should return an empty string when there is nothing to serialize","location":{"start":{"column":3,"line":5}}},{"id":"1","name":"stringify should serialize key-value pairs in insertion order with a leading question mark","location":{"start":{"column":3,"line":10}}},{"id":"2","name":"stringify should omit null and undefined values, including inside arrays","location":{"start":{"column":3,"line":14}}},{"id":"3","name":"stringify should keep empty strings","location":{"start":{"column":3,"line":18}}},{"id":"4","name":"stringify should convert numbers, booleans, and bigints with String()","location":{"start":{"column":3,"line":22}}},{"id":"5","name":"stringify should serialize arrays as repeated keys","location":{"start":{"column":3,"line":28}}},{"id":"6","name":"stringify should encode keys and values with encodeURIComponent","location":{"start":{"column":3,"line":32}}},{"id":"7","name":"stringify should throw a URIError for unpaired surrogates","location":{"start":{"column":3,"line":37}}},{"id":"8","name":"stringify should accept objects declared with an interface","location":{"start":{"column":3,"line":42}}},{"id":"9","name":"stringify should reject unsupported values at the type level","location":{"start":{"column":3,"line":54}}}],"source":"import { describe, expect, it } from 'vitest';\r\nimport { stringify } from './stringify';\r\n\r\ndescribe('stringify', () => {\r\n  it('should return an empty string when there is nothing to serialize', () => {\r\n    expect(stringify({})).toBe('');\r\n    expect(stringify({ a: null, b: undefined, c: [], d: [null, undefined] })).toBe('');\r\n  });\r\n\r\n  it('should serialize key-value pairs in insertion order with a leading question mark', () => {\r\n    expect(stringify({ b: 'y', a: 'x' })).toBe('?b=y&a=x');\r\n  });\r\n\r\n  it('should omit null and undefined values, including inside arrays', () => {\r\n    expect(stringify({ a: 1, b: null, c: undefined, d: [2, null, undefined, 3] })).toBe('?a=1&d=2&d=3');\r\n  });\r\n\r\n  it('should keep empty strings', () => {\r\n    expect(stringify({ a: '' })).toBe('?a=');\r\n  });\r\n\r\n  it('should convert numbers, booleans, and bigints with String()', () => {\r\n    expect(stringify({ a: 0, b: -0, c: 1.5, d: true, e: false, f: 10n, g: NaN })).toBe(\r\n      '?a=0&b=0&c=1.5&d=true&e=false&f=10&g=NaN'\r\n    );\r\n  });\r\n\r\n  it('should serialize arrays as repeated keys', () => {\r\n    expect(stringify({ tags: ['x y', '+'], ids: [1, 2] })).toBe('?tags=x%20y&tags=%2B&ids=1&ids=2');\r\n  });\r\n\r\n  it('should encode keys and values with encodeURIComponent', () => {\r\n    expect(stringify({ q: 'a b+c' })).toBe('?q=a%20b%2Bc');\r\n    expect(stringify({ 'a&b': 'x=y?z#w/v' })).toBe('?a%26b=x%3Dy%3Fz%23w%2Fv');\r\n  });\r\n\r\n  it('should throw a URIError for unpaired surrogates', () => {\r\n    expect(() => stringify({ a: '\\uD800' })).toThrow(URIError);\r\n    expect(() => stringify({ '\\uD800': 'a' })).toThrow(URIError);\r\n  });\r\n\r\n  it('should accept objects declared with an interface', () => {\r\n    interface Params {\r\n      id: number;\r\n      ref?: string;\r\n      tags: readonly string[];\r\n    }\r\n\r\n    const params: Params = { id: 1, tags: ['a'] };\r\n\r\n    expect(stringify(params)).toBe('?id=1&tags=a');\r\n  });\r\n\r\n  it('should reject unsupported values at the type level', () => {\r\n    // @ts-expect-error - nested objects are not supported\r\n    expect(typeof stringify({ filter: { status: 'open' } })).toBe('string');\r\n    // @ts-expect-error - Date is not supported\r\n    expect(typeof stringify({ date: new Date(0) })).toBe('string');\r\n    // @ts-expect-error - null is not an object with query values\r\n    expect(() => stringify(null)).toThrow(TypeError);\r\n  });\r\n});\r\n"}},"projectRoot":"C:\\Users\\patri\\AppData\\Local\\Temp\\mrbench\\es-toolkit","config":{"testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"vitest":{"configFile":"vitest.config.mts","related":true,"pool":"threads"},"coverageAnalysis":"perTest","mutate":["src/query-string/index.ts:1-1","src/query-string/stringify.ts:23-25","src/query-string/stringify.ts:27-30","src/query-string/stringify.ts:32-33","src/query-string/stringify.ts:35-36","src/query-string/stringify.ts:41-41"],"reporters":["json","progress-append-only"],"jsonReporter":{"fileName":"C:\\Users\\patri\\AppData\\Local\\Temp\\mrbench\\work\\2121\\mutation.json"},"concurrency":4,"incremental":false,"thresholds":{"high":80,"low":60,"break":null},"dryRunTimeoutMinutes":5,"tempDirName":".stryker-tmp","cleanTempDir":"always","ignorePatterns":["docs","benchmarks",".yarn",".github","dist","coverage","tests/browser-compat","tests/types"],"configFile":"C:\\Users\\patri\\AppData\\Local\\Temp\\mrbench\\work\\2121\\stryker.scoped.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly"