{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.domain.config.ts" },
  "mutate": ["packages/demo-domain/src/shipping.ts"],
  "reporters": ["json", "clear-text"],
  "jsonReporter": { "fileName": "evidence/mutation/mutation.json" },
  "concurrency": 2,
  "timeoutMS": 1000,
  "timeoutFactor": 1.5,
  "dryRunTimeoutMinutes": 1,
  "incremental": false,
  "thresholds": { "high": 100, "low": 80, "break": 0 },
  "ignorePatterns": ["evidence/**", "apps/**", "docs/**", "benchmarks/**", ".mutant-review/work/**"]
}
